{
  "name": "santo-desapego-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:relatorio": "jest --coverage --json --outputFile=tests/relatorio/resultado.json",
    "graficos": "python tests/graficos.py",
    "dev": "nodemon server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "utils/validacao.js",
      "utils/verificacao.js",
      "utils/usuarios.js",
      "utils/geolocalizacao.js",
      "utils/notificacoes.js",
      "services/anuncioService.js",
      "services/mercadoPagoService.js",
      "services/agenteAnuncioService.js",
      "services/agenteCompraService.js",
      "services/llmClient.js",
      "routes/ia.js",
      "routes/auth.js",
      "routes/pagamentos.js",
      "routes/mercadoPago.js",
      "routes/conversas.js",
      "routes/avaliacoes.js",
      "routes/anuncios.js",
      "routes/categorias.js",
      "routes/usuario.js",
      "routes/favoritos.js",
      "routes/admin.js",
      "utils/log.js"
    ],
    "coverageDirectory": "tests/relatorio/cobertura",
    "coverageReporters": ["text", "json-summary", "html"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.2.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  }
}
